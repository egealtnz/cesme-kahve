# Copy to .env (local) and set the same names as EAS environment variables for builds.
# Supabase → Project Settings → API. The anon/publishable key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Public pages (privacy policy etc.) — see legal-site/
EXPO_PUBLIC_LEGAL_BASE_URL=https://www.cesmekahve.com/uygulama
